+    /** Pauses this app's playback for lifecycle and audio-focus interruptions. */
+    public static void setPlaybackPaused(boolean paused) {
+        mPlaybackPaused = paused;
+        AudioTrack track = mAudioTrack;
+        if (track == null || track.getState() != AudioTrack.STATE_INITIALIZED)
+            return;
+        try {
+            if (paused)
+                track.pause();
+            else
+                track.play();
+        } catch (IllegalStateException e) {
+            Log.w(TAG, "Unable to change SDL playback state", e);
+        }
+    }

+    private void applySurfaceLayoutMode(int mode, int areaScalePercent)
+    {
+        FrameLayout.LayoutParams surfaceParams;
+        if (mode == SideMenu.DISPLAY_ORIGINAL_SIZE) {
+            int availableWidth = getResources().getDisplayMetrics().widthPixels;
+            int availableHeight = getResources().getDisplayMetrics().heightPixels;
+            float requestedScale = Math.max(SideMenu.MIN_GAME_AREA_SCALE,
+                Math.min(SideMenu.MAX_GAME_AREA_SCALE, areaScalePercent)) / 100f;
+            float fittingScale = Math.min(availableWidth / 512f, availableHeight / 384f);
+            float appliedScale = Math.min(requestedScale, fittingScale);
+            int width = Math.max(1, Math.round(512f * appliedScale));
+            int height = Math.max(1, Math.round(384f * appliedScale));
+            surfaceParams = new FrameLayout.LayoutParams(width, height, Gravity.CENTER);
+        } else {
+            surfaceParams = new FrameLayout.LayoutParams(
+                LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT, Gravity.CENTER);
+        }
+        mSurface.setLayoutParams(surfaceParams);
+        if (mCrtOverlay != null) {
+            FrameLayout.LayoutParams overlayParams = new FrameLayout.LayoutParams(
+                surfaceParams.width, surfaceParams.height, Gravity.CENTER);
+            mCrtOverlay.setLayoutParams(overlayParams);
+        }
+    }

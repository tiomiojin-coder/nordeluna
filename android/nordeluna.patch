+package com.mkxpz.launcher;
+
+import android.content.Context;
+import android.net.Uri;
+import android.os.Build;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.Locale;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipOutputStream;
+
+/** Creates a privacy-conscious diagnostic package selected by the user. */
+public final class ErrorReport
+{
+    private ErrorReport() { }
+
+    public static void write(Context context, Uri destination, String appVersion,
+                             String gamePath) throws IOException
+    {
+        try (OutputStream raw = context.getContentResolver().openOutputStream(destination, "w");
+             ZipOutputStream zip = raw == null ? null : new ZipOutputStream(raw)) {
+            if (zip == null)
+                throw new IOException("Não foi possível criar o relatório");
+
+            String info = "Aplicativo: Pokémon Nordeluna\n" +
+                "Versão: " + appVersion + "\n" +
+                "Data: " + new SimpleDateFormat("yyyy-MM-dd HH:mm:ss Z", Locale.ROOT)
+                    .format(new Date()) + "\n" +
+                "Fabricante: " + Build.MANUFACTURER + "\n" +
+                "Modelo: " + Build.MODEL + "\n" +
+                "Dispositivo: " + Build.DEVICE + "\n" +
+                "Android: " + Build.VERSION.RELEASE + "\n" +
+                "API: " + Build.VERSION.SDK_INT + "\n" +
+                "ABI: " + (Build.SUPPORTED_ABIS.length > 0 ? Build.SUPPORTED_ABIS[0] : "desconhecida") + "\n" +
+                "Caminho do jogo disponível: " + (gamePath != null) + "\n";
+            addText(zip, "informacoes.txt", info);
+            addText(zip, "logcat.txt", readLogcat());
+            CrashDiagnostics.addToZip(context, zip);
+            // Essentials' original event message is not always sent to logcat.
+            if (gamePath != null) {
+                addGameLog(zip, "nordeluna-event-errors.log",
+                    new File(gamePath, "nordeluna-event-errors.log"));
+                addGameLog(zip, "game-errorlog.txt", new File(gamePath, "errorlog.txt"));
+                addGameLog(zip, "online-errors.log", new File(gamePath, "nordeluna-online-errors.log"));
+                addGameLog(zip, "online-transport.log", new File(gamePath, "nordeluna-online-transport.log"));
+            }
+        }
+    }
+
+    private static void addGameLog(ZipOutputStream zip, String name, File file)
+        throws IOException
+    {
+        if (!file.isFile()) return;
+        // Bound report size and keep the latest diagnostics.
+        try (java.io.RandomAccessFile input = new java.io.RandomAccessFile(file, "r")) {
+            input.seek(Math.max(0, input.length() - 512 * 1024));
+            byte[] buffer = new byte[8192];
+            zip.putNextEntry(new ZipEntry(name));
+            int count;
+            while ((count = input.read(buffer)) != -1) zip.write(buffer, 0, count);
+            zip.closeEntry();
+        }
+    }
+
+    private static String readLogcat()
+    {
+        StringBuilder output = new StringBuilder();
+        try {
+            Process process = new ProcessBuilder("logcat", "-d", "-v", "threadtime", "-t", "1200")
+                .redirectErrorStream(true).start();
+            try (BufferedReader reader = new BufferedReader(
+                    new InputStreamReader(process.getInputStream(), StandardCharsets.UTF_8))) {
+                String line;
+                while ((line = reader.readLine()) != null)
+                    output.append(line).append('\n');
+            }
+            process.destroy();
+        } catch (Exception e) {
+            output.append("Não foi possível coletar o log: ").append(e).append('\n');
+        }
+        if (output.length() == 0)
+            output.append("Nenhuma linha de log estava disponível.\n");
+        return output.toString();
+    }
+
+    private static void addText(ZipOutputStream zip, String name, String value)
+        throws IOException
+    {
+        zip.putNextEntry(new ZipEntry(name));
+        zip.write(value.getBytes(StandardCharsets.UTF_8));
+        zip.closeEntry();
+    }
+}

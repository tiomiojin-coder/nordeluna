+    /**
+     * Installs the game archive bundled inside this standalone APK on first
+     * launch and after an app update. Later launches reuse the extracted files
+     * and go straight to the game.
+     */
+    private void installBundledGame()
+    {
+        if (mBundledInstallInProgress)
+            return;
+
+        mBundledInstallInProgress = true;
+
+        final ProgressDialog dialog = new ProgressDialog(this);
+        dialog.setMessage("Preparando Pokémon Nordeluna…");
+        dialog.setCancelable(false);
+        dialog.show();
+
+        new Thread(() -> {
+            boolean success = false;
+            String error = null;
+
+            try (InputStream in = getAssets().open(BUNDLED_GAME_ASSET)) {
+                File destRoot = new File(GAME_PATH_DEFAULT);
+                clearBundledGameFiles(destRoot);
+                success = ArchiveExtractor.extract(in, destRoot, new ArchiveExtractor.ProgressListener()
+                {
+                    @Override
+                    public void onProgress(String entryName) { }
+
+                    @Override
+                    public void onError(String message)
+                    {
+                        Log.e(TAG, message);
+                    }
+                });
+            } catch (IOException e) {
+                error = e.getMessage();
+            }
+
+            final boolean ok = success;
+            final String err = error;
+
+            runOnUiThread(() -> {
+                dialog.dismiss();
+                mBundledInstallInProgress = false;
+
+                if (!ok) {
+                    Toast.makeText(MainActivity.this,
+                        "Não foi possível preparar o jogo" +
+                        (err != null ? ": " + err : ""), Toast.LENGTH_LONG).show();
+                    mSideMenu.open();
+                    return;
+                }
+
+                File gameFolder = findGameFolder(new File(GAME_PATH_DEFAULT));
+                if (gameFolder == null) {
+                    Toast.makeText(MainActivity.this,
+                        "O pacote não contém Game.ini", Toast.LENGTH_LONG).show();
+                    mSideMenu.open();
+                    return;
+                }
+
+                GAME_PATH = gameFolder.getAbsolutePath();
+                persistGamePath(GAME_PATH);
+                getSharedPreferences(PREFS_NAME, MODE_PRIVATE).edit().putInt(
+                    PREFS_BUNDLED_VERSION, BuildConfig.VERSION_CODE).apply();
+                mSideMenu.setGamePath(GAME_PATH);
+                mSideMenu.close();
+                runSDLThread();
+            });
+        }, "Nordeluna installer").start();
+    }
+
+    /**
+     * Removes only files supplied by the bundled game before an update. Save
+     * data is stored under the configured app data path and is left intact.
+     */
+    private static void clearBundledGameFiles(File root)
+    {
+        String[] directories = {
+            "Audio", "Data", "Fonts", "Graphics", "Movies", "Plugins"
+        };
+        for (String directory : directories)
+            deleteRecursively(new File(root, directory));
+
+        String[] files = {
+            "Game.ini", "mkxp.json", "soundfont.sf2", "achievements.dat"
+        };
+        for (String filename : files)
+        {
+            File target = new File(root, filename);
+            if (target.exists() && !target.delete())
+                Log.w(TAG, "Could not remove old bundled file: " + target);
+        }
+    }
+
+    private static void deleteRecursively(File file)
+    {
+        if (!file.exists())
+            return;
+
+        File[] children = file.listFiles();
+        if (children != null)
+            for (File child : children)
+                deleteRecursively(child);
+
+        if (!file.delete())
+            Log.w(TAG, "Could not remove old bundled path: " + file);
+    }

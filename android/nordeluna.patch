+                    String path = existing.getString(i);
+                    if (!DISPLAY_PRELOAD_ASSET.equals(path)) preloads.put(path);
+                }
+            }
+            config.put("preloadScript", preloads);
+            json = config.toString(2);
+        } catch (JSONException e) {
+            Log.e(TAG, "Could not configure Android display preload", e);
+            return false;
+        }
+
+        try (FileOutputStream out = new FileOutputStream(configFile, false)) {
+            out.write(json.getBytes(StandardCharsets.UTF_8));
+            return true;
+        } catch (IOException e) {
+            Log.e(TAG, "Could not write display configuration", e);
+            return false;
+        }
+    }

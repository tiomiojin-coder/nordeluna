+    private boolean applyDisplayModeToGameConfig(int mode)
+    {
+        File configFile = new File(GAME_PATH, "mkxp.json");
+        if (!configFile.isFile())
+            return false;
+
+        StringBuilder sb = new StringBuilder();
+        try (FileInputStream in = new FileInputStream(configFile)) {
+            byte[] buffer = new byte[4096];
+            int count;
+            while ((count = in.read(buffer)) > 0)
+                sb.append(new String(buffer, 0, count, StandardCharsets.UTF_8));
+        } catch (IOException e) {
+            Log.e(TAG, "Could not read display configuration", e);
+            return false;
+        }
+
+        boolean keepAspect = mode != SideMenu.DISPLAY_FILL_SCREEN;
+        String json = setJsonBoolean(sb.toString(), "fixedAspectRatio", keepAspect);
+        json = setJsonBoolean(json, "integerScalingActive", false);
+        json = setJsonBoolean(json, "integerScalingLastMile", true);
+
+        try (FileOutputStream out = new FileOutputStream(configFile, false)) {
+            out.write(json.getBytes(StandardCharsets.UTF_8));
+            return true;
+        } catch (IOException e) {
+            Log.e(TAG, "Could not write display configuration", e);
+            return false;
+        }
+    }
+
+    private static String setJsonBoolean(String json, String key, boolean value)
+    {
+        Pattern pattern = Pattern.compile("(?m)^(\\s*\\\"" + Pattern.quote(key) +
+            "\\\"\\s*:\\s*)(true|false)");
+        Matcher matcher = pattern.matcher(json);
+        if (matcher.find())
+            return matcher.replaceFirst(Matcher.quoteReplacement(
+                matcher.group(1) + Boolean.toString(value)));
+
+        int closingBrace = json.lastIndexOf('}');
+        if (closingBrace < 0)
+            return json;
+
+        int previous = closingBrace - 1;
+        while (previous >= 0 && Character.isWhitespace(json.charAt(previous)))
+            previous--;
+        String comma = previous >= 0 && json.charAt(previous) != '{' ? "," : "";
+        return json.substring(0, closingBrace) + comma + "\n  \"" + key +
+            "\": " + value + "\n" + json.substring(closingBrace);
+    }
+
+    private void applySurfaceLayoutMode(int mode)
+    {
+        RelativeLayout.LayoutParams surfaceParams;
+        if (mode == SideMenu.DISPLAY_ORIGINAL_SIZE) {
+            // Nordeluna renders at 512x384. These are physical pixels on
+            // purpose: this option provides a true 1:1 game image.
+            surfaceParams = new RelativeLayout.LayoutParams(512, 384);
+            surfaceParams.addRule(RelativeLayout.CENTER_IN_PARENT);
+        } else {
+            surfaceParams = new RelativeLayout.LayoutParams(
+                LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT);
+        }
+        mSurface.setLayoutParams(surfaceParams);
+    }

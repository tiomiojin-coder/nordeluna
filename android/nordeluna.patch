+    private static int importZip(Context context, Uri uri, File[] roots) throws IOException
+    {
+        int imported = 0;
+        try (InputStream raw = context.getContentResolver().openInputStream(uri);
+             ZipInputStream zip = raw == null ? null : new ZipInputStream(raw)) {
+            if (zip == null)
+                throw new IOException("Não foi possível abrir o ZIP");
+            ZipEntry entry;
+            byte[] buffer = new byte[BUFFER_SIZE];
+            while ((entry = zip.getNextEntry()) != null) {
+                String safeName = new File(entry.getName()).getName();
+                if (entry.isDirectory() || !isSaveFileName(safeName))
+                    continue;
+                java.io.ByteArrayOutputStream contents = new java.io.ByteArrayOutputStream();
+                int count;
+                while ((count = zip.read(buffer)) > 0)
+                    contents.write(buffer, 0, count);
+                byte[] saveData = contents.toByteArray();
+                boolean copied = false;
+                for (File root : roots) {
+                    if (root == null || !root.isDirectory())
+                        continue;
+                    try (OutputStream out = new FileOutputStream(new File(root, safeName))) {
+                        out.write(saveData);
+                    }
+                    copied = true;
+                }
+                if (copied)
+                    imported++;
+            }
+        }
+        return imported;
+    }
+
+    private static void addFileToZip(ZipOutputStream zip, File source, String entryName)
+        throws IOException
+    {
+        zip.putNextEntry(new ZipEntry(entryName));
+        try (InputStream in = new FileInputStream(source)) {
+            copy(in, zip);
+        }
+        zip.closeEntry();
+    }
+
+    private static void pruneBackups(File directory, int keep)
+    {
+        File[] files = directory.listFiles((dir, name) -> name.endsWith(".zip"));
+        if (files == null || files.length <= keep)
+            return;
+        java.util.Arrays.sort(files, (a, b) -> Long.compare(b.lastModified(), a.lastModified()));
+        for (int i = keep; i < files.length; i++)
+            if (!files[i].delete())
+                Log.w(TAG, "Could not prune backup " + files[i]);
+    }
+

+        int[] size = GameSurfaceSize.calculate(availableWidth, availableHeight, mode, areaScalePercent);
+        int width = size[0], height = size[1];
+        FrameLayout.LayoutParams surfaceParams = (FrameLayout.LayoutParams) mSurface.getLayoutParams();
+        if (surfaceParams.width != width || surfaceParams.height != height ||

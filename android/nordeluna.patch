+    private boolean isControllerEvent(KeyEvent event)
+    {
+        return isPhysicalController(event.getDevice());
+    }
+
+    private boolean isPhysicalController(InputDevice device)
+    {
+        // Source constants share class bits with keyboards/touchscreens; a
+        // nonzero intersection alone would hide touch controls on phones.
+        // Some phone input drivers advertise gamepad sources despite being
+        // built-in. Only external devices may suppress touch controls on Q+.
+        return device != null && !device.isVirtual() &&
+            (Build.VERSION.SDK_INT < Build.VERSION_CODES.Q || device.isExternal()) &&
+            (device.supportsSource(InputDevice.SOURCE_GAMEPAD) ||
+             device.supportsSource(InputDevice.SOURCE_JOYSTICK));
+    }

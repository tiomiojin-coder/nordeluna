+    private void handleAudioFocusChange(int focusChange)
+    {
+        if (focusChange == AudioManager.AUDIOFOCUS_LOSS ||
+                focusChange == AudioManager.AUDIOFOCUS_LOSS_TRANSIENT) {
+            SDLAudioManager.setPlaybackPaused(true);
+            if (mStarted && !mPausedForAudioFocus) {
+                mPausedForAudioFocus = true;
+                pauseNativeThread();
+            }
+        } else if (focusChange == AudioManager.AUDIOFOCUS_GAIN) {
+            SDLAudioManager.setPlaybackPaused(false);
+            if (mStarted && mActivityResumed && mPausedForAudioFocus) {
+                mPausedForAudioFocus = false;
+                resumeNativeThread();
+            }
+        }
+    }
+
+    private void scheduleControllerRescan()
+    {
+        if (mMainHandler == null || !mStarted)
+            return;
+        mMainHandler.removeCallbacks(mControllerRescanRunnable);
+        mMainHandler.postDelayed(mControllerRescanRunnable, 350);
+    }
+
+    private final Runnable mControllerRescanRunnable = () -> {
+        try {
+            SDLControllerManager.pollInputDevices();
+            SDLControllerManager.pollHapticDevices();
+            Log.i(TAG, "Bluetooth/USB controller list refreshed");
+        } catch (Exception e) {
+            Log.w(TAG, "Controller rescan failed", e);
+        }
+    };
+
+    private void scheduleWhatsNew()
+    {
+        if (mMainHandler == null || !mStarted || mWhatsNewScheduled)
+            return;
+        SharedPreferences prefs = getSharedPreferences(PREFS_NAME, MODE_PRIVATE);
+        if (prefs.getInt(PREFS_WHATS_NEW_VERSION, 0) >= BuildConfig.VERSION_CODE)
+            return;
+        mWhatsNewScheduled = true;
+        mMainHandler.postDelayed(() -> {
+            if (!mActivityResumed) {
+                mWhatsNewScheduled = false;
+                return;
+            }
+            new AlertDialog.Builder(this)

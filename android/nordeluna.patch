+    @SuppressWarnings("deprecation")
+    private void requestGameAudioFocus()
+    {
+        // Don't claim Android audio focus when the player wants background
+        // music. The system can then mix SDL output with Spotify, YouTube
+        // Music and other media players instead of pausing them.
+        if (mAudioManager != null && !mMixExternalAudio) {
+            mAudioManager.requestAudioFocus(mAudioFocusListener,
+                AudioManager.STREAM_MUSIC, AudioManager.AUDIOFOCUS_GAIN);
+        }
+    }

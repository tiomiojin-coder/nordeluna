+    private boolean applyGraphicsFilterToGameConfig(int filter)
+    {
+        File configFile = new File(GAME_PATH, "mkxp.json");
+        if (!configFile.isFile())
+            return false;
+
+        StringBuilder sb = new StringBuilder();
+        try (FileInputStream in = new FileInputStream(configFile)) {
+            byte[] buffer = new byte[4096];
+            int count;
+            while ((count = in.read(buffer)) > 0)
+                sb.append(new String(buffer, 0, count, StandardCharsets.UTF_8));
+        } catch (IOException e) {
+            Log.e(TAG, "Could not read graphics filter configuration", e);
+            return false;
+        }
+
+        int smoothScaling;
+        switch (filter) {
+            case SideMenu.FILTER_BILINEAR:
+                smoothScaling = 1;
+                break;
+            case SideMenu.FILTER_BICUBIC:
+                smoothScaling = 2;
+                break;
+            case SideMenu.FILTER_LANCZOS:
+                smoothScaling = 3;
+                break;
+            case SideMenu.FILTER_XBRZ:
+                smoothScaling = 4;
+                break;
+            default:
+                // Nearest-neighbor is intentionally used under CRT as well.
+                smoothScaling = 0;
+                break;
+        }
+        String json = setJsonInteger(sb.toString(), "smoothScaling", smoothScaling);
+        json = setJsonInteger(json, "smoothScalingDown", smoothScaling);
+        json = setJsonInteger(json, "bitmapSmoothScaling", smoothScaling);
+        json = setJsonInteger(json, "bitmapSmoothScalingDown", smoothScaling);
+
+        try (FileOutputStream out = new FileOutputStream(configFile, false)) {
+            out.write(json.getBytes(StandardCharsets.UTF_8));
+            return true;
+        } catch (IOException e) {
+            Log.e(TAG, "Could not write graphics filter configuration", e);
+            return false;
+        }
+    }

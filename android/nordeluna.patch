+    private boolean applyDisplayModeToGameConfig(int mode)
+    {
+        File configFile = new File(GAME_PATH, "mkxp.json");
+        if (!configFile.isFile())
+            return false;
+
+        StringBuilder sb = new StringBuilder();
+        try (FileInputStream in = new FileInputStream(configFile)) {
+            byte[] buffer = new byte[4096];
+            int count;
+            while ((count = in.read(buffer)) > 0)
+                sb.append(new String(buffer, 0, count, StandardCharsets.UTF_8));
+        } catch (IOException e) {
+            Log.e(TAG, "Could not read display configuration", e);
+            return false;
+        }
+
+        boolean keepAspect = mode != SideMenu.DISPLAY_FILL_SCREEN;
+        String json = setJsonBoolean(sb.toString(), "fixedAspectRatio", keepAspect);
+        json = setJsonBoolean(json, "integerScalingActive", false);
+        json = setJsonBoolean(json, "integerScalingLastMile", true);
+        json = setJsonBoolean(json, "fullscreen", true);
+
+        // Refresh from the APK even when bundled_game_version is unchanged:
+        // installing a corrected 1.8 must also repair existing installations.
+        try (InputStream in = getAssets().open(DISPLAY_PRELOAD_ASSET);
+             FileOutputStream out = new FileOutputStream(new File(GAME_PATH, DISPLAY_PRELOAD_ASSET))) {
+            byte[] buffer = new byte[4096];
+            int count;
+            while ((count = in.read(buffer)) != -1) out.write(buffer, 0, count);
+        } catch (IOException e) {
+            Log.e(TAG, "Could not install Android display compatibility script", e);
+            return false;
+        }
+        try {
+            JSONObject config = new JSONObject(json);
+            JSONArray existing = config.optJSONArray("preloadScript");
+            JSONArray preloads = new JSONArray();
+            preloads.put(DISPLAY_PRELOAD_ASSET);
+            if (existing != null) {

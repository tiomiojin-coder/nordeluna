+    private void handleAudioFocusChange(int focusChange)
+    {
+        if (focusChange == AudioManager.AUDIOFOCUS_LOSS ||
+                focusChange == AudioManager.AUDIOFOCUS_LOSS_TRANSIENT) {
+            SDLAudioManager.setPlaybackPaused(true);
+            if (mStarted && !mPausedForAudioFocus) {
+                mPausedForAudioFocus = true;
+                if (mMovieBridge != null) mMovieBridge.setAudioFocusPaused(true);
+                pauseNativeThread();
+            }
+        } else if (focusChange == AudioManager.AUDIOFOCUS_GAIN) {
+            SDLAudioManager.setPlaybackPaused(false);
+            if (mStarted && mActivityResumed && mPausedForAudioFocus) {
+                mPausedForAudioFocus = false;
+                if (mMovieBridge != null) mMovieBridge.setAudioFocusPaused(false);
+                resumeNativeThread();
+            }
+        }
+    }

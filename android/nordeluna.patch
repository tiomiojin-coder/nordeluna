new file mode 100644
--- /dev/null
+++ b/android/app/src/main/java/com/mkxpz/GameSurfaceSize.java
@@ -0,0 +1,19 @@
+package com.mkxpz;
+
+/** Presentation size in actual container pixels; RGSS remains 512 x 384. */
+final class GameSurfaceSize {
+    private GameSurfaceSize() { }
+
+    // Matches SideMenu DISPLAY_KEEP_ASPECT=0, FILL_SCREEN=1, ORIGINAL_SIZE=2.
+    static int[] calculate(int availableWidth, int availableHeight, int mode, int percent) {
+        if (availableWidth < 1 || availableHeight < 1)
+            throw new IllegalArgumentException("Surface container has not been measured");
+        if (mode == 1) return new int[] { availableWidth, availableHeight };
+        double scale = Math.min(availableWidth / 512.0, availableHeight / 384.0);
+        if (mode == 2) scale = Math.min(scale, Math.max(100, Math.min(250, percent)) / 100.0);
+        return new int[] {
+            Math.max(1, Math.min(availableWidth, (int) Math.round(512 * scale))),
+            Math.max(1, Math.min(availableHeight, (int) Math.round(384 * scale)))
+        };
+    }
+}

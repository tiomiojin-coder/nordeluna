+    private final Runnable mControllerRescanRunnable = () -> {
+        try {
+            SDLControllerManager.pollInputDevices();
+            SDLControllerManager.pollHapticDevices();
+            boolean connected = hasPhysicalController();
+            if (connected != mPhysicalControllerConnected) {
+                mPhysicalControllerConnected = connected;
+                mPressedControllerKeys.clear();
+                updateControllerButtons();
+                if (mControllerAxesView != null)
+                    mControllerAxesView.setText(R.string.controller_buttons_idle);
+            }
+            refreshTouchControlsVisibility();
+            updateControllerStatus();
+            Log.i(TAG, "Bluetooth/USB controller list refreshed");
+        } catch (Exception e) {
+            Log.w(TAG, "Controller rescan failed", e);
+        }
+    };

+    private void observeControllerMotion(MotionEvent event)
+    {
+        InputDevice device = event.getDevice();
+        if (!isPhysicalController(device) || mControllerAxesView == null ||
+                !event.isFromSource(InputDevice.SOURCE_JOYSTICK)) return;
+        StringBuilder axes = new StringBuilder(device.getName()).append("\n");
+        appendAxis(axes, event, MotionEvent.AXIS_X, "X");
+        appendAxis(axes, event, MotionEvent.AXIS_Y, "Y");
+        appendAxis(axes, event, MotionEvent.AXIS_Z, "Z");
+        appendAxis(axes, event, MotionEvent.AXIS_RZ, "RZ");
+        appendAxis(axes, event, MotionEvent.AXIS_HAT_X, "HAT X");
+        appendAxis(axes, event, MotionEvent.AXIS_HAT_Y, "HAT Y");
+        appendAxis(axes, event, MotionEvent.AXIS_LTRIGGER, "L2");
+        appendAxis(axes, event, MotionEvent.AXIS_RTRIGGER, "R2");
+        if (mControllerAxesView != null) mControllerAxesView.setText(axes.toString());
+    }
+
+    private void appendAxis(StringBuilder out, MotionEvent event, int axis, String label)
+    {
+        float value = event.getAxisValue(axis);
+        out.append(label).append(": ")
+            .append(String.format(Locale.US, "%.2f", value)).append("   ");
+    }

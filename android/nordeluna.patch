+    private void observeControllerKey(KeyEvent event)
+    {
+        if (!isControllerEvent(event)) return;
+        int key = event.getKeyCode();
+        if (event.getAction() == KeyEvent.ACTION_DOWN) mPressedControllerKeys.add(key);
+        else if (event.getAction() == KeyEvent.ACTION_UP) mPressedControllerKeys.remove(key);
+        updateControllerButtons();
+    }

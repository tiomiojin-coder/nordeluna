+    private int updateFallbackDirection(int previousKey, int nextKey)
+    {
+        if (previousKey == nextKey)
+            return previousKey;
+        if (previousKey != KeyEvent.KEYCODE_UNKNOWN)
+            mOnKeyUpListener.onKeyUp(previousKey);
+        if (nextKey != KeyEvent.KEYCODE_UNKNOWN)
+            mOnKeyDownListener.onKeyDown(nextKey);

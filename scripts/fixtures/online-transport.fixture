module System
  def self.is_android?; true; end
end
module HTTPLite
  def self.post_body(*args); raise 'Android called unsafe native HTTPLite'; end
end
# The Python-embedded DLL has no supported Ruby I/O stack. Test its mailbox
# contract in memory; the standalone Java integration exercises actual files/HTTP.
$bridge_files = {}
module BridgeFixtureFiles
  def bridge_path?(path); path.to_s.include?('.nordeluna-online-bridge'); end
  def binwrite(path, text); return super unless bridge_path?(path); $bridge_files[File.expand_path(path)] = text.dup; text.bytesize; end
  def binread(path)
    return super unless bridge_path?(path)
    if $bridge_locked_path == File.expand_path(path) && $bridge_locked_reads.to_i > 0
      $bridge_locked_reads -= 1
      raise Errno::EACCES, path
    end
    $bridge_files.fetch(File.expand_path(path)) { raise Errno::ENOENT, path }
  end
  def file?(path); bridge_path?(path) ? $bridge_files.key?(File.expand_path(path)) : super; end
  def size(path); bridge_path?(path) ? binread(path).bytesize : super; end
  def mtime(path); bridge_path?(path) ? Time.at(0) : super; end
  def rename(a, b); return super unless bridge_path?(a); $bridge_files[File.expand_path(b)] = $bridge_files.delete(File.expand_path(a)); 0; end
  def delete(path); return super unless bridge_path?(path); $bridge_files.delete(File.expand_path(path)); 1; end
end
File.singleton_class.prepend(BridgeFixtureFiles)
module BridgeFixtureDir
  def glob(pattern, *args)
    return super unless pattern.include?('.nordeluna-online-bridge')
    $bridge_files.keys.select { |path| File.fnmatch?(File.expand_path(pattern), path) }
  end
end
Dir.singleton_class.prepend(BridgeFixtureDir)
module NordelunaOnline
  class << self
    alias frame_before_bridge_test frame
    def frame
      directory = Transport.android? ? File.join(Dir.pwd, '.nordeluna-online-bridge') : File.join(Dir.pwd, ".nordeluna-online-bridge-windows-v2-#{Process.pid}")
      if $bridge_resume_test
        File.binwrite(File.join(directory, 'status'), '1')
        $bridge_resume_test = false
      end
      Dir.glob(File.join(directory, '*.request')).each do |file|
        session, endpoint, body = File.binread(file).split("\n", 3)
        check(session == 'test-session', 'request session changed')
        check(endpoint == 'https://example.org/api', 'request URL changed')
        payload = JSON.parse(body)
        check(payload['protocol'] == 1, 'protocol missing from safe transport')
        if $bridge_pause_test
          File.binwrite(File.join(directory, 'status'), '0')
        else
          File.binwrite(file.sub(/\.request\z/, '.response'), "200\n" + JSON.dump({'ok'=>true, 'nick'=>'Lúna'}))
          File.delete(file)
        end
      end
      frame_before_bridge_test
    end
  end
end
begin
  File.binwrite('.nordeluna-online-bridge/session', 'test-session')
  File.binwrite('.nordeluna-online-bridge/status', '1')
  threads_before = Thread.list.length
  File.binwrite('.nordeluna-online-bridge/status', '')
  $bridge_resume_test = true
  answer = NordelunaOnline.request('https://example.org', {'action'=>'health'})
  check(answer['nick'] == 'Lúna', 'Android bridge corrupted UTF-8')
  check(Thread.list.length == threads_before, 'Android transport created Ruby worker threads')
  $bridge_pause_test = true
  begin
    NordelunaOnline.request('https://example.org', {'action'=>'health'})
    raise 'paused transport reported success'
  rescue NordelunaOnline::ConnectionLost
  end
  check(Dir.glob('.nordeluna-online-bridge/*.cancel').length == 1, 'timeout/pause did not send cooperative cancellation')
ensure
  module NordelunaOnline
    class << self; alias frame frame_before_bridge_test; end
  end
end

# Windows must use the child-process mailbox too, never the native HTTP binding.
module System
  def self.is_android?; false; end
  def self.is_windows?; true; end
end
module BridgeFixtureHelper
  def file?(path)
    return true if path.to_s.end_with?('/bridge/WindowsHttpBridge-2.exe')
    super
  end
end
File.singleton_class.prepend(BridgeFixtureHelper)
module Process
  class << self
    alias spawn_before_bridge_fixture spawn
    def spawn(*args)
      $bridge_spawn_arguments = args
      directory = File.join(Dir.pwd, ".nordeluna-online-bridge-windows-v2-#{pid}")
      File.binwrite(File.join(directory,'session'),'test-session')
      File.binwrite(File.join(directory,'status'),'1')
      1234
    end
  end
end
$bridge_pause_test = false
module NordelunaOnline
  class << self; alias frame_after_android_test frame; end
end
# Temporarily reuse the tested mailbox-frame handler for the Windows directory.
module NordelunaOnline
  class << self; alias frame frame_before_bridge_test; end
end
# The Android fixture restored #frame; this small pump represents the broker ACK.
module NordelunaOnline
  class << self
    def frame
      directory = File.join(Dir.pwd, ".nordeluna-online-bridge-windows-v2-#{Process.pid}")
      Dir.glob(File.join(directory,'*.request')).each do |file|
        File.binwrite(file.sub(/\.request\z/,'.response'), "200\n{\"ok\":true}")
        File.delete(file)
      end
      frame_before_bridge_test
    end
  end
end
check(NordelunaOnline.request('https://example.org',{'action'=>'health'})['ok'], 'Windows bypassed mailbox')
check($bridge_spawn_arguments[0].end_with?('WindowsHttpBridge-2.exe') && $bridge_spawn_arguments[1] == Dir.pwd && $bridge_spawn_arguments[2] == Process.pid.to_s,
      'Windows helper launch used a shell or wrong parent')
# Reproduce Windows sharing violations on the actual ticket, before a reply.
ticket = NordelunaOnline::Transport::WindowsTicket.new('https://example.org/api', '{}')
$bridge_locked_path = File.expand_path(File.join(ticket.mailbox_directory, 'status'))
$bridge_locked_reads = 3
3.times { check(ticket.alive?, 'temporary sharing lock escaped instead of retrying') }
check(ticket.alive?, 'ticket failed to recover after sharing lock')
$bridge_locked_reads = 100
ticket.instance_variable_set(:@access_retry_until, NordelunaOnline.now - 1)
begin
  ticket.alive?
  raise 'permanent marker lock was not bounded'
rescue NordelunaOnline::ConnectionLost
end
$bridge_locked_path = nil
ticket.cancel
module Process
  class << self; alias spawn spawn_before_bridge_fixture; end
end
module NordelunaOnline
  class << self; alias frame frame_before_bridge_test; end
end

# Copy exactly the public code, never the session token or an invitation URL.
module Input
  def self.clipboard=(value); $copied_room_code = value; end
end
alias pbMessage_before_clipboard_test pbMessage
def pbMessage(text, commands = nil, *args)
  commands ? $room_menu_choices.shift : nil
end
$room_menu_choices = [0, 1]
NordelunaOnline.show_room_code('ABCDEFGH')
check($copied_room_code == 'ABCDEFGH', 'clipboard did not receive room code')
$room_menu_choices = [2]
begin
  NordelunaOnline.show_room_code('ABCDEFGH')
  raise 'cancel room ignored'
rescue NordelunaOnline::Cancelled
end
rejects('clipboard accepted arbitrary content') { NordelunaOnline.show_room_code('token:secret') }
alias pbMessage pbMessage_before_clipboard_test
'OK: Android resumes without mtime/partial-marker false failures; Windows uses hidden mailbox helper; native HTTP bypassed on both; real target UI, six Noctgeist party, Mega and emote menu regressions passed.'

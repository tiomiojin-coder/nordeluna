def _INTL(text,*args);args.each_with_index { |a,i|text=text.gsub('{'+(i+1).to_s+'}',a.to_s) };text;end
def pbResolveBitmap(path);DIMS.key?(path+'.png') ? path+'.png' : nil;end
def pbSetSystemFont(*);end
def pbSetSmallFont(*);end
def pbDrawTextPositions(bitmap,rows);raise 'disposed text bitmap' if bitmap.disposed?;end
def pbSEPlay(*);end
def pbPlayDecisionSE;end
def pbUpdateSceneMap;end
def pbUpdateSpriteHash(hash);hash.each_value { |s|s.update if s && !s.disposed? };end
def pbDisposeSpriteHash(hash)
  hash.each_value { |s|s.dispose if s && !s.disposed? };hash.clear
end
def pbInSafari?;false;end

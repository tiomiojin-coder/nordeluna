# Strict XP-like graphics/input surface. No save or network I/O.
Rect = Struct.new(:x,:y,:width,:height)
Font = Struct.new(:size,:color,:bold)
class Color
  attr_reader :values
  def initialize(*values); @values=values; end
end
class Bitmap
  attr_reader :width,:height,:font,:ops,:path
  def initialize(w,h=nil)
    if h; @width,@height=w,h; else; @path=w;@width,@height=DIMS.fetch(w);end
    @font=Font.new(22,Color.new(248,248,248),false);@ops=[];@disposed=false
  end
  def clear; raise 'disposed bitmap clear' if @disposed;@ops.clear;end
  def fill_rect(*args); raise 'disposed bitmap fill' if @disposed;end
  def blt(x,y,b,r); raise 'disposed bitmap blt' if @disposed || b.disposed?;@ops << [x,y,b.path,r.to_a];end
  def text_size(s);Rect.new(0,0,s.to_s.length*10,24);end
  def disposed?;@disposed;end
  def dispose;raise 'double bitmap dispose' if @disposed;@disposed=true;end
end
class Sprite
  attr_accessor :x,:y,:z,:ox,:oy,:zoom_x,:zoom_y,:opacity,:bitmap,:src_rect,:color
  attr_reader :visible
  def initialize(viewport=nil)
    @x=@y=@z=@ox=@oy=0;@zoom_x=@zoom_y=1;@opacity=255;@disposed=false;@visible=true
    @src_rect=Rect.new(0,0,0,0)
  end
  def visible=(v);raise 'expected bool' unless v==true || v==false;@visible=v;end
  def update;raise 'disposed sprite update' if @disposed;end
  def disposed?;@disposed;end
  def dispose;raise 'double sprite dispose' if @disposed;@disposed=true;end
end
class BitmapSprite < Sprite
  def initialize(w,h,v=nil);super(v);self.bitmap=Bitmap.new(w,h);end
  def dispose;bitmap.dispose unless bitmap.disposed?;super;end
end
class IconSprite < Sprite
  def initialize(x,y,viewport);super(viewport);@x=x;@y=y;end
  def setBitmap(path)
    bitmap.dispose if bitmap && !bitmap.disposed?
    self.bitmap=Bitmap.new(path+'.png')
  end
  def dispose;bitmap.dispose if bitmap && !bitmap.disposed?;super;end
end
class AnimatedSprite < Sprite
  def initialize(path,frames,w,h,speed,viewport);super(viewport);self.bitmap=Bitmap.new(path+'.png');end
  def play;end
  def dispose;bitmap.dispose unless bitmap.disposed?;super;end
end
class PokemonIconSprite < Sprite
  def initialize(pokemon,viewport);super(viewport);end
end
class Viewport
  attr_accessor :z
  def initialize(*);@disposed=false;end
  def dispose;raise 'double viewport dispose' if @disposed;@disposed=true;end
  def disposed?;@disposed;end
end
module RPG;module Cache
  def self.load_bitmap(root,name);Bitmap.new(root+name+'.png');end
end;end
module Graphics
  def self.width;512;end
  def self.height;384;end
  def self.frame_rate;60;end
  def self.average_frame_rate;60;end
  def self.update;end
end
module System;def self.uptime;1.0;end;end
module Input
  LEFT=:LEFT;RIGHT=:RIGHT;UP=:UP;DOWN=:DOWN;BACK=:BACK;ACTION=:ACTION;USE=:USE
  class << self;attr_accessor :queue,:keys;end
  self.queue=[];self.keys=[]
  def self.update;self.keys=queue.shift || [:BACK];end
  def self.trigger?(key);keys.include?(key);end
  def self.repeat?(key);keys.include?(key);end
  def self.press?(key);keys.include?(key);end
end
module Settings;MAX_PARTY_SIZE=6;SAFARI_STEPS=500;end
module MenuHandlers
  HANDLERS=Hash.new { |hash,key| hash[key]={} }
  def self.add(menu,key,hash);HANDLERS[menu][key]=hash;end
  def self.each_available(menu)
    HANDLERS[menu].sort_by { |_,h|h['order'] || 0 }.each do |key,h|
      next if h['condition'] && !h['condition'].call
      name=h['name'].is_a?(Proc) ? h['name'].call : h['name']
      yield key,h,name
    end
  end
end

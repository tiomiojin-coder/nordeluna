# Graphics.update runs the real AreaMenuFrames callback while drain is waiting.
# A ticket completing on that frame used to be collected and cleared beneath
# drain, whose next loop condition called nil.alive?.
class AreaFrameCompletionTicket < RoomReplyTicket
  def initialize(reply);super(reply);@checks=0;end
  def alive?;@checks+=1;@checks==1;end
end
old_poll=channel.instance_variable_get(:@next_poll)
channel.instance_variable_set(:@next_poll,NordelunaOnline.now+999)
channel.instance_variable_set(:@request_started,NordelunaOnline.now)
channel.instance_variable_set(:@worker_deadline,NordelunaOnline.now+5)
channel.instance_variable_set(:@operation,:ping)
channel.instance_variable_set(:@worker,AreaFrameCompletionTicket.new({'ok'=>true,'room'=>'PRACA','peers'=>[],'messages'=>[],
  'chat_epoch'=>'drain-regression','members'=>1,'revision'=>5,'version'=>'0.6.0'}))
channel.drain
check(channel.active? && channel.instance_variable_get(:@worker).nil?,'frame completion during drain destroyed the online session')
channel.instance_variable_set(:@next_poll,old_poll)

# A nested frame may cancel/replace a request. Do not collect its replacement
# or release the outer drain lock from a reentrant drain call.
module AreaDrainFrameHook
  def update(*args)
    hook=$area_drain_frame_hook
    $area_drain_frame_hook=nil
    hook.call if hook
    super
  end
end
Graphics.singleton_class.prepend(AreaDrainFrameHook)
replacement=RoomReplyTicket.new({'ok'=>true})
original_ticket=AreaFrameCompletionTicket.new({'ok'=>true})
channel.instance_variable_set(:@worker,original_ticket)
channel.instance_variable_set(:@worker_deadline,NordelunaOnline.now+5)
$area_drain_frame_hook=proc do
  channel.drain
  check(channel.instance_variable_get(:@draining),'nested drain released the outer lock')
  original_ticket.cancel
  channel.instance_variable_set(:@worker,replacement)
end
channel.drain
check(channel.active? && channel.instance_variable_get(:@worker).equal?(replacement),'drain collected a replacement request')
check(!channel.instance_variable_get(:@draining),'drain lock survived completion')
channel.instance_variable_set(:@worker,nil)
check(channel.connect('PRACA') && areas.anchor==original,'duplicate entry replaced campaign anchor')
areas.instance_variable_set(:@busy,true)
rejects('concurrent teleport not blocked') {channel.connect('PRACA')}
check(areas.busy? && channel.active? && areas.anchor==original,'concurrent request cleared lock or disconnected original session')
areas.instance_variable_set(:@busy,false)
# Presence updates in menus must not expire; idle state sends only a heartbeat.

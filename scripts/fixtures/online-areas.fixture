$area_time+=0.3;channel.update
check($area_calls.count { |r| r['action']=='map_update' }==sent,'redundant idle movement packet sent')
$area_time+=1.6;channel.update;channel.update
check($area_calls.count { |r| r['action']=='map_update' }>sent,'stationary player waited too long for incoming peers/chat')
$game_temp.in_menu=true
16.times {$area_time+=1;Graphics.update}
$game_temp.in_menu=false
channel.drain
check(channel.active? && $area_calls.count { |r| r['action']=='map_update' }>sent,'menus stopped presence heartbeats')
token=channel.instance_variable_get(:@token)
[5,6].each do |map|
  $game_temp.player_new_map_id=map;$game_temp.player_new_x=2;$game_temp.player_new_y=3;$game_temp.player_new_direction=4
  $scene.transfer_player
  check(areas.anchor==original && channel.instance_variable_get(:@token)==token,'area transition replaced anchor/session')
end

# Manual writes, both menu implementations and multi-slot saves are denied on
# all three maps. Transaction receipts still persist at the campaign position.
[1,5,6].each do |map|
  $map_factory.setup(map);$game_map=$map_factory.map
  before=$area_files[SaveData::FILE_PATH].dup
  check(Game.save.equal?(false),'manual save accepted on an online map')
  check(pbSaveScreen.equal?(false),'global save menu accepted online save')
  check(PokemonSaveScreen.new.pbSaveScreen.equal?(false),'save screen accepted online save')
  check(REInterface::MultiSave.save_to_slot(1).equal?(false),'multi-slot save accepted online save')
  begin
    SaveData.save_to_file(SaveData::FILE_PATH)
    raise 'low-level writer bypassed online save block'
  rescue IOError
  end
  check($area_files[SaveData::FILE_PATH]==before,'denied save changed the existing file')
  $area_progress={'reward'=>map};areas.checked_save!
  receipt=Marshal.load($area_files[SaveData::FILE_PATH])
  check(receipt[:map_factory].map.map_id==42 && [receipt[:game_player].x,receipt[:game_player].y,receipt[:game_player].direction]==[15,22,8],'transaction persisted an online position')
  check(receipt[:game_variables]['reward']==map && $game_map.map_id==map,'transaction lost progress or moved the live player')
  NordelunaOnline.save_trade!
  traded=Marshal.load($area_files[SaveData::FILE_PATH])
  check(traded[:map_factory].map.map_id==42 && $game_map.map_id==map,'trade autosave persisted an online position or teleported the player')
end
check(($area_screen_calls || 0)==0 && ($area_global_screen_calls || 0)==0 && ($area_slot_calls || 0)==0,'save UI/slot implementation ran before the guard')

